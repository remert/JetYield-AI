# Optional. Without a key the app runs in "demo mode" using the deterministic
# JetYield engine for recommendations and chat, so the live demo never breaks.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: requests per IP per minute for the AI routes (default 20).
# AI_RATE_LIMIT_PER_MINUTE=20
